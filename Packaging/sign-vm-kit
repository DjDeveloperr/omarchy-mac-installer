#!/bin/bash
#
# Signs the Try Omarchy kit inside the app as this installer, so macOS asks for
# Accessibility, Microphone and Camera in the installer's name
# (docs/try-omarchy-trial.md). Every Mach-O in the kit is signed, as
# notarization requires: the runtime's libraries and zstd, QEMU with the
# hypervisor and microphone, the helper with the camera and microphone, then
# the kit bundle. The kit must still pass its launcher's own check.
#
#   Packaging/sign-vm-kit APP CODESIGN_ARGUMENTS...
#
# CODESIGN_ARGUMENTS are the identity and options the app's own signing uses,
# for example --force --sign - --options runtime --timestamp=none.

set -euo pipefail

fail() {
  echo "sign-vm-kit: $*" >&2
  exit 1
}

(( $# >= 2 )) || fail "usage: sign-vm-kit APP CODESIGN_ARGUMENTS..."
app=$1
shift
script_directory=$(cd "$(dirname "$0")" && pwd -P)
# shellcheck source=identity.conf
source "$script_directory/identity.conf"
kit="$app/Contents/Helpers/Try Omarchy Kit.app"
[[ -d $kit && ! -L $kit ]] || fail "the app carries no kit"
identifier="$INSTALLER_APP_IDENTIFIER.vm-kit"
runtime="$kit/Contents/Resources/runtime"
qemu="$runtime/bin/Try Omarchy"
helper="$kit/Contents/MacOS/omarchy-vm-helper"
entitlements="$script_directory/entitlements"

while IFS= read -r -d '' code; do
  [[ $code == "$qemu" ]] && continue
  codesign "$@" --identifier "$identifier" "$code"
done < <(find "$runtime/lib" "$runtime/bin" -type f \( -name '*.dylib' -o -perm -u+x \) -print0)
codesign "$@" --identifier "$identifier" --entitlements "$entitlements/vm-qemu.entitlements" "$qemu"
codesign "$@" --identifier "$identifier" --entitlements "$entitlements/vm-helper.entitlements" "$helper"
codesign "$@" --identifier "$identifier" --entitlements "$entitlements/vm-helper.entitlements" "$kit"
codesign --verify --deep --strict "$kit"
